# Foundry project endpoint: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Name of the voice agent created in the Foundry portal
VOICE_AGENT_NAME=
# Project connection (category AzureCommunicationServices) created in step 3 of the README
ACS_CONNECTION_NAME=
# Object ID of the Teams resource account, as a bare GUID. The 28:orgid: prefix is removed if present.
RESOURCE_ACCOUNT_OBJECT_ID=
# Optional: display number of the resource account, for example +353XXXXXXXXX
TEAMS_PHONE_NUMBER=
# Optional: relay Event Grid IncomingCall events to the binding's incoming_call_url (default false).
# Leave false when the Event Grid subscription already points at incoming_call_url.
FORWARD_INCOMING_CALLS=false
# Seconds between call status polls
MONITOR_POLL_SECONDS=2
# Safety limit: end a call that is still in progress after this many seconds (0 disables)
MAX_CALL_SECONDS=7200
