# JOIN_MODE selects how the agent joins meetings:
#   invite   (default) someone adds the agent's phone number to the call; Foundry + ACS. Variables below.
#   calendar the agent reads its own Outlook calendar through Microsoft Graph and joins Teams meetings.
#            Variables in the CALENDAR MODE block at the end (deploy.sh --mode calendar writes a separate env file).
JOIN_MODE=invite

# Written by infra/deploy.sh into .env. Edit only if you configure things by hand.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
VOICE_AGENT_NAME=teams-voice-agent
ACS_CONNECTION_NAME=acs
# Teams resource account object ID, as a bare GUID (a 28:orgid: prefix is removed)
RESOURCE_ACCOUNT_OBJECT_ID=
# Optional display number, for example +353XXXXXXXXX
TEAMS_PHONE_NUMBER=
# Optional agent settings used when the agent is created
VOICE_MODEL=gpt-realtime
VOICE_INSTRUCTIONS=You are a helpful voice assistant in a Microsoft Teams call. Keep answers short.
# Wake and sleep words, comma separated. The agent stays silent until it hears a wake word, and goes
# silent again on a sleep word. Set WAKE_WORDS= (empty) to disable and let it answer everything.
WAKE_WORDS=hey assistant
SLEEP_WORDS=go quiet
# Safety limit for `watch`: end a call still in progress after this many seconds (0 disables)
MAX_CALL_SECONDS=7200

# ---- CALENDAR MODE (JOIN_MODE=calendar) ----
# AGENT_MAILBOX=agent@contoso.com
# CALLBACK_URL=https://bot.contoso.com/api/calling     # public HTTPS URL Graph posts call notifications to
# GRAPH_TENANT_ID=<tenant id>                          # needed for short teams.microsoft.com/meet/ URLs
# AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET  # app-only Graph access when running locally
# POLL_SECONDS=30  JOIN_LEAD_SECONDS=60  LEAVE_AFTER_END_SECONDS=300  MAX_JOIN_ATTEMPTS=3  LISTEN=0.0.0.0:8080
