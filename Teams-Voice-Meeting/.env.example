# Written by infra/deploy.sh into .env. Edit only if you configure things by hand.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
VOICE_AGENT_NAME=teams-voice-agent
ACS_CONNECTION_NAME=acs
# Teams resource account object ID, as a bare GUID (a 28:orgid: prefix is removed)
RESOURCE_ACCOUNT_OBJECT_ID=
# Optional display number, for example +353XXXXXXXXX
TEAMS_PHONE_NUMBER=
# Optional agent settings used when the agent is created
VOICE_MODEL=gpt-realtime
VOICE_INSTRUCTIONS=You are a helpful voice assistant in a Microsoft Teams call. Keep answers short.
# Safety limit for `watch`: end a call still in progress after this many seconds (0 disables)
MAX_CALL_SECONDS=7200
