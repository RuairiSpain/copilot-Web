{
  "permissions": {
    "allow": [
      "Bash(go test ./...)",
      "Bash(go test -race ./...)",
      "Bash(go test -race -cover ./...)",
      "Bash(go vet ./...)",
      "Bash(go build ./...)",
      "Bash(go mod tidy)",
      "Bash(go run ./cmd/rulecatalog validate)",
      "Bash(go run ./cmd/rulecatalog validate --phase0)",
      "Bash(go run ./cmd/rulecatalog generate-docs)",
      "Bash(go run ./cmd/rulecatalog generate-docs --check)",
      "Bash(go run ./cmd/rulecatalog generate-overlap)",
      "Bash(go run ./cmd/rulecatalog generate-overlap --check)",
      "Bash(gofmt -l .)",
      "Bash(gofmt -w .)",
      "Bash(staticcheck ./...)",
      "Bash(govulncheck ./...)",
      "Bash(bash foundry-doctor/scripts/claude/verify-phase.sh)",
      "Bash(bash foundry-doctor/scripts/claude/verify-phase.sh --strict)",
      "Bash(bash foundry-doctor/scripts/claude/check-rule-catalog.sh)",
      "Bash(bash foundry-doctor/scripts/claude/check-no-secrets.sh)",
      "Bash(python3 -m unittest discover -s foundry-doctor/scripts/claude)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.azure/*/.env)",
      "Read(~/.azure/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Bash(az group delete *)",
      "Bash(az resource delete *)",
      "Bash(azd down *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/foundry-doctor/scripts/claude/guard-bash.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/foundry-doctor/scripts/claude/post-edit.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/foundry-doctor/scripts/claude/stop-check.sh" }
        ]
      }
    ]
  }
}
