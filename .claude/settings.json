{
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go mod tidy)",
      "Bash(go run ./cmd/rulecatalog *)",
      "Bash(gofmt *)",
      "Bash(staticcheck *)",
      "Bash(govulncheck *)",
      "Bash(bash foundry-doctor/scripts/claude/*)",
      "Bash(foundry-doctor/scripts/claude/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(az group delete *)",
      "Bash(az resource delete *)",
      "Bash(azd down *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/foundry-doctor/scripts/claude/guard-bash.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/foundry-doctor/scripts/claude/post-edit.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/foundry-doctor/scripts/claude/stop-check.sh" }
        ]
      }
    ]
  }
}
