# Local runs only. In Foundry, FOUNDRY_PROJECT_ENDPOINT is injected and the rest comes
# from azure.yaml.
FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.4-mini"
# Where the git repository and worktrees are created. Defaults to $HOME/workspace.
WORKSPACE_ROOT="./workspace"
# Seconds before a shell command is killed (10 to 1800).
DEV_TEAM_COMMAND_TIMEOUT_SECONDS="180"
# Upper bounds for one Magentic run.
# DEV_TEAM_MAX_ROUNDS="12"
# LOG_LEVEL="INFO"
