# Values for `azd env set`. They feed ${VAR} substitutions in azure.yaml.
# Never commit real values. Copy to .env only for local experiments.

# --- Azure AI Search (used by the shared toolbox) ---------------------------
SEARCH_ENDPOINT="https://<search-service>.search.windows.net"
SEARCH_INDEX_NAME="product-docs"

# --- Prompt agent: PDF knowledge and MCP server ------------------------------
# Written by `make ingest` (see agents/prompt-kb/ingest_knowledge.py).
KB_VECTOR_STORE_ID="vs_..."
KB_MCP_SERVER_URL="https://<your-mcp-server>/mcp"
# Secret bearer token for the MCP server. Set with `azd env set`, never in git.
KB_MCP_TOKEN="..."

# --- Values azd produces itself (listed so every ${VAR} is documented) -------
# AZURE_AI_MODEL_DEPLOYMENT_NAME  set by `azd ai agent init`
# TOOLBOX_SEARCH_AND_CODE_MCP_ENDPOINT  set by `azd deploy` after the toolbox is created

# --- Local runs only (azd ai agent run sets these for you) -------------------
# FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
# TOOLBOX_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/search-and-code/mcp?api-version=v1"
# WORKSPACE_ROOT="./workspace"
