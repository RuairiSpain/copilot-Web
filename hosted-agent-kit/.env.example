# ---- required ----
# Foundry project endpoint: https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# ---- authentication of callers ----
# entra: validate Microsoft Entra ID bearer tokens (production). development: no tokens, local only.
POOL_AUTH_MODE=entra
POOL_ENTRA_TENANT_ID=
# One or more accepted audiences, comma separated, for example api://<client-id>
POOL_ENTRA_AUDIENCE=
# App role names (change only if your app registration uses different names)
POOL_INVOKE_ROLE=Pool.Invoke
POOL_ADMIN_ROLE=Pool.Admin
POOL_DIAGNOSTICS_ROLE=Pool.Diagnostics

# ---- credentials the service uses to call Foundry ----
# In Azure this is the Container App managed identity. Locally use a service principal:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# With a user-assigned managed identity in Azure, set AZURE_CLIENT_ID to its client id.

# ---- pool configuration ----
# Path to a standalone config file. When unset, the agentPool section of ./azure.yaml is used.
# AGENT_POOL_CONFIG=./agent-pool.example.yaml

# ---- limits and timeouts ----
POOL_MAX_BODY_BYTES=1048576
POOL_DEFAULT_TIMEOUT_SECONDS=120
POOL_MAX_TIMEOUT_SECONDS=900
POOL_MAX_STREAM_SECONDS=600
POOL_RETRY_AFTER_SECONDS=10
POOL_UPSTREAM_THROTTLE_RETRIES=2
POOL_DELETE_RETRIES=3
POOL_CREATE_READY_TIMEOUT_SECONDS=120

# ---- restart recovery for stateful agents ----
# Secret (at least 32 characters) that derives each user's session id, so users get their sessions
# back after a restart. Keep it stable: changing it orphans existing sessions. Stateful agents
# cannot use min_warm_sessions while it is set.
# POOL_SESSION_ID_KEY=
# Constant isolation key. Only needed if an agent endpoint uses the Header authorisation scheme.
# POOL_FOUNDRY_ISOLATION_KEY=

# ---- operations ----
POOL_LOG_LEVEL=INFO
# Bind address. Defaults to 127.0.0.1. The container image sets 0.0.0.0.
# POOL_HOST=127.0.0.1
# POOL_PORT=8080
# Also probe Foundry from /health/ready. Off by default so an outage does not restart the service.
POOL_READINESS_PROBE_FOUNDRY=false
# Expose Prometheus text at /metrics (admin role required)
POOL_METRICS_ENDPOINT_ENABLED=false
# Return X-Pool-Session-Id to callers holding the diagnostics role
POOL_DIAGNOSTIC_SESSION_ID_HEADER=false
# Azure Monitor export (needs the azure-monitor extra, which the container image includes)
# APPLICATIONINSIGHTS_CONNECTION_STRING=
