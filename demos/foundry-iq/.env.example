# Produced by scripts/provision_infra.sh — or fill in by hand against existing
# resources. Load with:  set -a && . ./.env && set +a

SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AOAI_ENDPOINT=https://<aoai-account>.openai.azure.com

AOAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AOAI_CHAT_MODEL=gpt-5.4-mini
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AOAI_EMBEDDING_MODEL=text-embedding-3-large

STORAGE_ACCOUNT=<storage-account-name>
STORAGE_CONTAINER=eu-directives
# Full ARM resource id — the blob knowledge source uses ResourceId= auth, not a key.
STORAGE_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<name>

KNOWLEDGE_BASE=es-employment-kb
BLOB_KNOWLEDGE_SOURCE=eu-directives-ks
INDEX_KNOWLEDGE_SOURCE=hr-templates-ks
HR_INDEX=hr-templates-index

# Optional. Preview surface is required for answer synthesis and for the token
# counters the trace viewer renders.
SEARCH_API_VERSION=2026-08-01-preview
# Optional, for 4_trace.py --log-analytics
LOG_ANALYTICS_WORKSPACE=
