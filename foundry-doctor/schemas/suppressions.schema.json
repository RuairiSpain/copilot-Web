{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry-doctor.local/schemas/suppressions.schema.json",
  "title": "Foundry Doctor suppressions",
  "description": "Accepted findings with a reason, an owner and an expiry. An entry is valid through the end of its expiry day (UTC). Expired entries do not hide the finding and raise FND-SYS-SUPPRESSION-EXPIRED.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "suppressions"],
  "properties": {
    "version": { "const": 1 },
    "suppressions": {
      "type": "array",
      "items": { "$ref": "#/$defs/suppression" }
    }
  },
  "$defs": {
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "reason", "owner", "expires"],
      "oneOf": [
        { "required": ["fingerprint"], "not": { "required": ["resource"] } },
        { "required": ["resource"], "not": { "required": ["fingerprint"] } }
      ],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1, "not": { "pattern": "^FND-SYS-SUPPRESSION-" } },
        "fingerprint": { "type": "string", "pattern": "^fp1:[0-9a-f]{32}$" },
        "resource": { "$ref": "#/$defs/selector" },
        "reason": { "type": "string", "pattern": "\\S" },
        "owner": { "type": "string", "pattern": "\\S" },
        "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD, a real calendar date." }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "kind": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "pointer": { "type": "string" }
      }
    }
  }
}
