{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry-doctor.local/schemas/baseline.schema.json",
  "title": "Foundry Doctor baseline",
  "description": "Fingerprints of findings an existing project has accepted. Matches hide only exact fingerprints (ADR-008). Engine diagnostics (FND-SYS-*, bicep/*) cannot be baselined.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedBy", "entries"],
  "properties": {
    "version": { "const": 1 },
    "generatedBy": { "type": "string", "description": "Tool version that generated the file." },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "ruleId", "ruleVersion", "resource"],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^fp1:[0-9a-f]{32}$" },
        "ruleId": { "type": "string", "minLength": 1, "not": { "pattern": "^(FND-SYS-|bicep/)" } },
        "ruleVersion": { "type": "integer", "minimum": 1 },
        "resource": { "$ref": "#/$defs/resource" },
        "firstSeen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD, supplied by the caller." }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "pointer": { "type": "string" }
      }
    }
  }
}
