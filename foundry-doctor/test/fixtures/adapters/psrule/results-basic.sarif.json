{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": { "driver": { "name": "PSRule" } },
      "results": [
        {
          "ruleId": "Azure.KeyVault.SoftDelete",
          "level": "error",
          "message": { "text": "Soft delete is not enabled on the Key Vault." },
          "locations": [
            {
              "physicalLocation": { "artifactLocation": { "uri": "input/0001.parameters.json" } },
              "logicalLocations": [{ "name": "kv1", "fullyQualifiedName": "kv1" }]
            }
          ]
        },
        {
          "ruleId": "Azure.AI.DisableLocalAuth",
          "level": "warning",
          "message": { "text": "Local authentication should be disabled." },
          "locations": [
            {
              "physicalLocation": { "artifactLocation": { "uri": "input/0001.parameters.json" } },
              "logicalLocations": [{ "name": "aiacct1" }]
            }
          ]
        },
        {
          "ruleId": "Azure.AI.DisableLocalAuth",
          "level": "warning",
          "message": { "text": "Keys are enabled." },
          "locations": [
            {
              "physicalLocation": { "artifactLocation": { "uri": "input/0001.parameters.json" } },
              "logicalLocations": [{ "name": "aiacct1" }]
            }
          ]
        },
        {
          "ruleId": "Azure.Storage.SoftDelete",
          "level": "note",
          "message": { "text": "Blob soft delete is off." },
          "locations": [
            {
              "physicalLocation": { "artifactLocation": { "uri": "input/0001.json" } },
              "logicalLocations": [{ "name": "stg-from-parameter" }]
            }
          ]
        },
        {
          "ruleId": "Azure.Storage.Passed",
          "kind": "pass",
          "message": { "text": "ok" }
        }
      ]
    }
  ]
}
