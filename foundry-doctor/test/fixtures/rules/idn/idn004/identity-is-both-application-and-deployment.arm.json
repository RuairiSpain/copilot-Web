{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {},
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2026-09-01",
      "name": "acct",
      "location": "eastus",
      "kind": "AIServices",
      "sku": {
        "name": "S0"
      },
      "properties": {},
      "identity": {
        "type": "SystemAssigned"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2026-09-01",
      "name": "acct/proj",
      "location": "eastus",
      "properties": {},
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami')]": {}
        }
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2024-11-30",
      "name": "uami",
      "location": "eastus"
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
      "apiVersion": "2024-11-30",
      "name": "uami/gh",
      "properties": {
        "issuer": "https://token.actions.githubusercontent.com",
        "subject": "repo:contoso/app:environment:prod",
        "audiences": [
          "api://AzureADTokenExchange"
        ]
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "r1",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b24988ac-6180-42a0-ab88-20f7382dd24c')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami'), '2024-11-30').principalId]",
        "principalType": "ServicePrincipal"
      },
      "scope": "[resourceGroup().id]"
    }
  ]
}
