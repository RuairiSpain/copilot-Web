{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {},
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2026-09-01",
      "name": "acct",
      "location": "eastus",
      "kind": "AIServices",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "capabilitySettings": {
          "vectorStore": "[resourceId('Microsoft.Search/searchServices', 'srch')]",
          "blobStore": "[resourceId('Microsoft.Storage/storageAccounts', 'stor')]",
          "documentStore": "[resourceId('Microsoft.DocumentDB/databaseAccounts', 'cosm')]"
        }
      },
      "identity": {
        "type": "SystemAssigned"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2026-09-01",
      "name": "acct/proj",
      "location": "eastus",
      "properties": {},
      "identity": {
        "type": "SystemAssigned"
      }
    },
    {
      "type": "Microsoft.Search/searchServices",
      "apiVersion": "2024-01-01",
      "name": "srch",
      "location": "eastus"
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2024-01-01",
      "name": "stor",
      "location": "eastus"
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts",
      "apiVersion": "2024-01-01",
      "name": "cosm",
      "location": "eastus"
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2024-01-01",
      "name": "reg",
      "location": "eastus"
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects/connections",
      "apiVersion": "2026-09-01",
      "name": "acct/proj/c1",
      "properties": {
        "authType": "ProjectManagedIdentity",
        "category": "AzureStorageAccount",
        "target": "https://x.example",
        "metadata": {
          "ResourceId": "[resourceId('Microsoft.ContainerRegistry/registries', 'reg')]"
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "r1",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '8ebe5a00-799e-43f5-93ac-243d3dce84a7')]",
        "principalId": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', 'acct', 'proj'), '2026-09-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "scope": "[resourceId('Microsoft.Search/searchServices', 'srch')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "r2",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7ca78c08-252a-4471-8644-bb5ff32d4ba0')]",
        "principalId": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', 'acct', 'proj'), '2026-09-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "scope": "[resourceId('Microsoft.Search/searchServices', 'srch')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "r3",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
        "principalId": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', 'acct', 'proj'), '2026-09-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', 'stor')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "r4",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b7e6dc6d-f1e8-4753-8033-0f276bb0955b')]",
        "principalId": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', 'acct', 'proj'), '2026-09-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "scope": "[format('Microsoft.Storage/storageAccounts/{0}/blobServices/default/containers/{1}', 'stor', 'ws1-azureml-agent')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "r5",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '230815da-be43-4aae-9cb4-875f7bd000aa')]",
        "principalId": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', 'acct', 'proj'), '2026-09-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "scope": "[resourceId('Microsoft.DocumentDB/databaseAccounts', 'cosm')]"
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments",
      "apiVersion": "2025-10-15",
      "name": "cosm/sqlra1",
      "properties": {
        "roleDefinitionId": "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlRoleDefinitions', 'cosm', '00000000-0000-0000-0000-000000000002')]",
        "principalId": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', 'acct', 'proj'), '2026-09-01', 'full').identity.principalId]",
        "scope": "[format('{0}/dbs/enterprise_memory', resourceId('Microsoft.DocumentDB/databaseAccounts', 'cosm'))]"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "r6",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
        "principalId": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', 'acct', 'proj'), '2026-09-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', 'reg')]"
    }
  ]
}
