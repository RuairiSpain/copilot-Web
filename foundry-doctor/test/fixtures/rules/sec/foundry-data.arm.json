{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "searchKeysOff": { "type": "bool", "defaultValue": true },
    "cosmosKeysOff": { "type": "bool" }
  },
  "resources": [
    { "type": "Microsoft.CognitiveServices/accounts", "apiVersion": "2026-09-01", "name": "fdacct", "kind": "AIServices",
      "properties": { "disableLocalAuth": true } },
    { "type": "Microsoft.CognitiveServices/accounts/projects", "apiVersion": "2026-09-01", "name": "fdacct/fdproj", "properties": {} },
    { "type": "Microsoft.CognitiveServices/accounts/connections", "apiVersion": "2026-09-01", "name": "fdacct/search-conn",
      "properties": { "category": "CognitiveSearch", "authType": "AAD", "target": "https://fdsearch.search.invalid",
        "metadata": { "ResourceId": "[resourceId('Microsoft.Search/searchServices', 'fdsearch')]" } } },
    { "type": "Microsoft.CognitiveServices/accounts/connections", "apiVersion": "2026-09-01", "name": "fdacct/cosmos-conn",
      "properties": { "category": "CosmosDb", "authType": "AAD", "target": "https://fdcosmos.documents.invalid",
        "metadata": { "ResourceId": "[resourceId('Microsoft.DocumentDB/databaseAccounts', 'fdcosmos')]" } } },
    { "type": "Microsoft.CognitiveServices/accounts/connections", "apiVersion": "2026-09-01", "name": "fdacct/storage-conn",
      "properties": { "category": "AzureStorageAccount", "authType": "AAD", "target": "https://fdstorage.blob.invalid",
        "metadata": { "ResourceId": "[resourceId('Microsoft.Storage/storageAccounts', 'fdstorage')]" } } },
    { "type": "Microsoft.CognitiveServices/accounts/capabilityHosts", "apiVersion": "2026-09-01", "name": "fdacct/default",
      "properties": { "capabilityHostKind": "Agents", "vectorStoreConnections": ["search-conn"],
        "threadStorageConnections": ["cosmos-conn"], "storageConnections": ["storage-conn"] } },
    { "type": "Microsoft.Search/searchServices", "apiVersion": "2025-05-01", "name": "fdsearch",
      "properties": { "disableLocalAuth": "[parameters('searchKeysOff')]" } },
    { "type": "Microsoft.DocumentDB/databaseAccounts", "apiVersion": "2026-03-15", "name": "fdcosmos",
      "properties": { "disableLocalAuth": "[parameters('cosmosKeysOff')]", "ipRules": [ { "ipAddressOrRange": "0.0.0.0" } ] } },
    { "type": "Microsoft.Storage/storageAccounts", "apiVersion": "2026-06-01", "name": "fdstorage",
      "properties": { "allowSharedKeyAccess": false, "allowBlobPublicAccess": false, "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2", "networkAcls": { "defaultAction": "Deny", "ipRules": [ { "value": "203.0.113.10" } ] } } },
    { "type": "Microsoft.Search/searchServices", "apiVersion": "2025-05-01", "name": "unrelated", "properties": {} }
  ]
}
