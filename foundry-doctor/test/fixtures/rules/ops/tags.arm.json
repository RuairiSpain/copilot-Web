  "resources": [
    { "type": "Microsoft.CognitiveServices/accounts", "apiVersion": "2026-09-01", "name": "acct-missing", "location": "westeurope", "kind": "AIServices", "sku": { "name": "S0" } },
    { "type": "Microsoft.CognitiveServices/accounts", "apiVersion": "2026-09-01", "name": "acct-bad-format", "location": "westeurope", "tags": { "ENV": "production", "costcode": "X1" } },
    { "type": "Microsoft.CognitiveServices/accounts", "apiVersion": "2026-09-01", "name": "acct-ok", "location": "westeurope", "tags": { "env": "prod", "CostCode": "CC-1234" } },
    { "type": "Microsoft.CognitiveServices/accounts", "apiVersion": "2026-09-01", "name": "acct-union", "location": "westeurope", "tags": "[union(createObject('Env', 'prod'), createObject('CostCode', 'CC-1234'))]" },
