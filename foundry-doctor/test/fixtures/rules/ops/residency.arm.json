    { "type": "Microsoft.CognitiveServices/accounts", "apiVersion": "2026-09-01", "name": "acct-param", "location": "[parameters('location')]" },
    { "type": "Microsoft.Search/searchServices", "apiVersion": "2025-05-01", "name": "search-far", "location": "brazilsouth" },
    { "type": "Microsoft.CognitiveServices/accounts/deployments", "apiVersion": "2026-09-01", "name": "acct-eu/dep-gs", "sku": { "name": "GlobalStandard", "capacity": 10 }, "properties": { "model": { "format": "OpenAI", "name": "gpt-x", "version": "1" } } },
    { "type": "Microsoft.CognitiveServices/accounts/deployments", "apiVersion": "2026-09-01", "name": "acct-eu/dep-batch", "sku": { "name": "GlobalBatch" }, "properties": { "model": { "format": "OpenAI", "name": "gpt-x", "version": "1" } } },
    { "type": "Microsoft.CognitiveServices/accounts/deployments", "apiVersion": "2026-09-01", "name": "acct-eu/dep-dz", "sku": { "name": "DataZoneStandard" }, "properties": { "model": { "format": "OpenAI", "name": "gpt-x", "version": "1" } } },
    { "type": "Microsoft.CognitiveServices/accounts/deployments", "apiVersion": "2026-09-01", "name": "acct-eu/dep-std", "sku": { "name": "Standard" }, "properties": { "model": { "format": "OpenAI", "name": "gpt-x", "version": "1" } } },
    { "type": "Microsoft.CognitiveServices/accounts/deployments", "apiVersion": "2026-09-01", "name": "acct-eu/dep-dev", "sku": { "name": "DeveloperTier" }, "properties": { "model": { "format": "OpenAI", "name": "gpt-x", "version": "1" } } },
    { "type": "Microsoft.CognitiveServices/accounts/deployments", "apiVersion": "2026-09-01", "name": "acct-eu/dep-weird", "sku": { "name": "SomethingNew" }, "properties": { "model": { "format": "OpenAI", "name": "gpt-x", "version": "1" } } },
    { "type": "Microsoft.CognitiveServices/accounts/deployments", "apiVersion": "2026-09-01", "name": "acct-eu/dep-param", "sku": { "name": "[parameters('skuName')]" }, "properties": { "model": { "format": "OpenAI", "name": "gpt-x", "version": "1" } } },
    { "type": "Microsoft.CognitiveServices/accounts/deployments", "apiVersion": "2026-09-01", "name": "acct-eu/dep-nosku", "properties": { "model": { "format": "OpenAI", "name": "gpt-x", "version": "1" } } }
