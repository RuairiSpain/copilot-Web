  "azure-government-zone-names": {
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {},
    "resources": [
      {
        "apiVersion": "2026-09-01",
        "kind": "AIServices",
        "location": "swedencentral",
        "name": "acct",
        "properties": {
          "publicNetworkAccess": "Disabled"
        },
        "sku": {
          "name": "S0"
        },
        "type": "Microsoft.CognitiveServices/accounts"
      },
      {
        "apiVersion": "2024-05-01",
        "location": "swedencentral",
        "name": "pe",
        "properties": {
          "privateLinkServiceConnections": [
            {
              "name": "c",
              "properties": {
                "groupIds": [
                  "account"
                ],
                "privateLinkServiceId": "[resourceId('Microsoft.CognitiveServices/accounts', 'acct')]"
              }
            }
          ],
          "subnet": {
            "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'vnet', 'snet')]"
          }
        },
        "type": "Microsoft.Network/privateEndpoints"
      },
      {
        "apiVersion": "2024-05-01",
        "location": "swedencentral",
        "name": "vnet",
        "properties": {
          "addressSpace": {
            "addressPrefixes": [
              "10.0.0.0/16"
            ]
          }
        },
        "type": "Microsoft.Network/virtualNetworks"
      },
      {
        "apiVersion": "2024-05-01",
        "dependsOn": [
          "vnet"
        ],
        "name": "vnet/snet",
        "properties": {
          "addressPrefix": "10.0.0.0/24"
        },
        "type": "Microsoft.Network/virtualNetworks/subnets"
      },
      {
        "apiVersion": "2024-05-01",
        "dependsOn": [
          "pe"
        ],
        "name": "pe/default",
        "properties": {
          "privateDnsZoneConfigs": [
            {
              "name": "z0",
              "properties": {
                "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.cognitiveservices.azure.us')]"
              }
            }
          ]
        },
        "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups"
      }
    ]
  },
