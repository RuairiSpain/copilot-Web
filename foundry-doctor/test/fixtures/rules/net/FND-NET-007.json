    "contentVersion": "1.0.0.0",
    "parameters": {
      "a": {
        "type": "string"
      }
    },
    "resources": [
      {
        "apiVersion": "2026-09-01",
        "kind": "AIServices",
        "location": "swedencentral",
        "name": "acct",
        "properties": {
