  "all-three-dependents-disabled-with-endpoints": {
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {},
    "resources": [
      {
        "apiVersion": "2026-09-01",
        "kind": "AIServices",
        "location": "swedencentral",
        "name": "acct",
        "properties": {
          "capabilitySettings": {
            "blobStore": "[resourceId('Microsoft.Storage/storageAccounts', 'st')]",
            "documentStore": "[resourceId('Microsoft.DocumentDB/databaseAccounts', 'cos')]",
            "vectorStore": "[resourceId('Microsoft.Search/searchServices', 'srch')]"
          },
          "publicNetworkAccess": "Disabled"
        },
        "sku": {
          "name": "S0"
        },
        "type": "Microsoft.CognitiveServices/accounts"
      },
      {
        "apiVersion": "2025-01-01",
        "kind": "StorageV2",
        "location": "swedencentral",
        "name": "st",
        "properties": {
          "publicNetworkAccess": "Disabled"
        },
        "sku": {
          "name": "Standard_LRS"
        },
        "type": "Microsoft.Storage/storageAccounts"
      },
      {
        "apiVersion": "2025-04-15",
        "location": "swedencentral",
        "name": "cos",
        "properties": {
          "publicNetworkAccess": "Disabled"
        },
        "type": "Microsoft.DocumentDB/databaseAccounts"
      },
      {
        "apiVersion": "2025-05-01",
        "location": "swedencentral",
        "name": "srch",
        "properties": {
          "publicNetworkAccess": "Disabled"
        },
        "sku": {
          "name": "standard"
        },
        "type": "Microsoft.Search/searchServices"
      },
      {
        "apiVersion": "2024-05-01",
        "location": "swedencentral",
        "name": "pe-st",
        "properties": {
          "privateLinkServiceConnections": [
            {
              "name": "c",
              "properties": {
                "groupIds": [
                  "blob"
                ],
                "privateLinkServiceId": "[resourceId('Microsoft.Storage/storageAccounts', 'st')]"
              }
            }
          ],
          "subnet": {
            "id": "[parameters('peSubnetId')]"
          }
        },
        "type": "Microsoft.Network/privateEndpoints"
      },
      {
        "apiVersion": "2024-05-01",
        "location": "swedencentral",
        "name": "pe-co",
        "properties": {
          "privateLinkServiceConnections": [
            {
              "name": "c",
              "properties": {
                "groupIds": [
                  "Sql"
                ],
                "privateLinkServiceId": "[resourceId('Microsoft.DocumentDB/databaseAccounts', 'cos')]"
              }
            }
          ],
          "subnet": {
            "id": "[parameters('peSubnetId')]"
          }
        },
        "type": "Microsoft.Network/privateEndpoints"
      },
      {
        "apiVersion": "2024-05-01",
        "location": "swedencentral",
        "name": "pe-se",
        "properties": {
          "privateLinkServiceConnections": [
            {
              "name": "c",
              "properties": {
                "groupIds": [
                  "searchService"
                ],
                "privateLinkServiceId": "[resourceId('Microsoft.Search/searchServices', 'srch')]"
              }
            }
          ],
          "subnet": {
            "id": "[parameters('peSubnetId')]"
          }
        },
        "type": "Microsoft.Network/privateEndpoints"
      }
    ]
  },
