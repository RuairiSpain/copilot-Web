{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "CosmosDB_Endpoint": "https://<your-cosmos-account>.documents.azure.com:443/",
    "CosmosDB_Database": "ai-usage-db",
    "CosmosDB_QuotaOverridesContainer": "quota-overrides",
    "CosmosDB_QuotaOverrideRequestsContainer": "quota-override-requests",

    "QuotaOverride_DefaultDurationDays": "30",
    "QuotaOverride_EscalationMultiplier": "3",
    "QuotaOverride_MonthlyResetIncludesPermanent": "false",

    "QuotaApproval_NotificationWebhookUrl": "https://YOUR-TEAMS-OR-EMAIL-WEBHOOK-HERE",

    "Smtp_Host": "smtp.office365.com",
    "Smtp_Port": "587",
    "Smtp_User": "quota-notifications@yourtenant.onmicrosoft.com",
    "Smtp_Password": "USE-A-KEY-VAULT-REFERENCE-IN-PRODUCTION-SEE-QUOTA-SERVICE-BICEP",
    "Smtp_FromAddress": "quota-notifications@yourtenant.onmicrosoft.com",

    "Entra_TenantId": "<your-tenant-id>",
    "Entra_Audience": "api://<gateway-app-client-id>",
    "Entra_OpenIdConfigUrl": "https://login.microsoftonline.com/<your-tenant-id>/v2.0/.well-known/openid-configuration",
    "QuotaOverride_RequireTokenRevalidation": "true"
  }
}
