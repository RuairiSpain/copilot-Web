# --- Database ---
DATABASE_URL="postgresql://copilot:copilot@localhost:5432/copilot_web"
# Alternative to the above: set PGHOST/PGUSER/PGPASSWORD/PGDATABASE
# (PGPORT/PGSSLMODE optional) instead — src/server/bootstrap-env.ts
# synthesizes DATABASE_URL from them at startup if it isn't set directly.
# This is what the Azure Container Apps deployment (infra/) uses, since
# Container Apps secrets can't be interpolated into a composed env var.

# --- Auth.js / GitHub OAuth App ---
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Token encryption ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Server ---
PORT="3000"
