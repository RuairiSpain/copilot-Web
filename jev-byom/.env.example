# Copy to .env for local runs. Every variable has a default in
# config/settings.py; these are the ones worth setting by hand.

# --- calibration store: pick one -------------------------------------------
# Local development (no Azure):
JEV_LOCAL_REGISTRY_DIR=./.calibration
# Azure, connection string:
# BLOB_CONN_STR=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# Azure, managed identity (preferred in Container Apps):
# BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
BLOB_CONTAINER_NAME=jev-calibration
JEV_BLOB_PREFIX=calibration

# --- base model -------------------------------------------------------------
# 'hash' needs no weights and is useful for a first smoke test.
JEV_MODEL_BACKEND=huggingface
JEV_MODEL_NAME=distilbert-base-uncased
# JEV_MODEL_REVISION=main
JEV_MODEL_NUM_LABELS=2
JEV_MODEL_MAX_LENGTH=256
JEV_MODEL_DEVICE=cpu

# --- calibration knobs ------------------------------------------------------
JEV_VALIDATION_SPLIT=0.2
JEV_NUMERIC_BINS=10
JEV_NUMERIC_TOLERANCE=0.1
JEV_BOOLEAN_THRESHOLD=0.5
JEV_TRAIN_MIN_SAMPLES=10

# --- service ----------------------------------------------------------------
# JEV_API_KEY=change-me
JEV_REQUIRE_CALIBRATION=false
JEV_LOG_LEVEL=INFO
JEV_LOG_JSON=true
